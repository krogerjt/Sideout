PORT=8787
HOST=127.0.0.1
NCAA_BASE_URL=https://ncaa-api.henrygd.me
# Optional header for a private ncaa-api instance
NCAA_HEADER_KEY=
DATA_PATH=./data/sideout.sqlite
POLL_SECONDS=20
# Abuse limits per client IP. Behind a proxy, name the header that carries the real client IP (fly-client-ip on Fly.io).
RATE_LIMIT_PER_MINUTE=120
DEVICE_LIMIT_PER_HOUR=20
CLIENT_IP_HEADER=
# Server-wide cap on followed matches; each iPhone can follow up to 10.
MAX_ACTIVITIES=5000
# Shown on /privacy for questions and deletion requests.
PRIVACY_CONTACT=
# Team ID, key ID, bundle ID and one of the key settings are required for lock-screen updates.
APNS_TEAM_ID=
APNS_KEY_ID=
# Either a path to the .p8 file, or its contents in APNS_PRIVATE_KEY (newlines may be written as \n).
APNS_PRIVATE_KEY_PATH=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=com.example.sideout
# development for Xcode builds, production for TestFlight/App Store builds
APNS_ENVIRONMENT=development
