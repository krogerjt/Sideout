PORT=8787
HOST=127.0.0.1
# Generate a long random key. Enter the same key in the iPhone app's Settings.
ACCESS_KEY=replace-with-at-least-32-random-characters
NCAA_BASE_URL=https://ncaa-api.henrygd.me
# Optional header for a private ncaa-api instance
NCAA_HEADER_KEY=
DATA_PATH=./data/sideout.sqlite
POLL_SECONDS=20
# All four are required to enable background lock-screen updates.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY_PATH=
APNS_BUNDLE_ID=com.example.sideout
# development for Xcode builds, production for TestFlight/App Store builds
APNS_ENVIRONMENT=development
